
# Adding an alias? Not here: ~/best-linux-environment/aliases (every machine) or
# ~/best-linux-environment/aliases.local (this machine) — that repo is the one place.

# zshrc sets this before sourcing us; the fallback keeps the file usable alone.
ZSH_CONFIG_DIR="${ZSH_CONFIG_DIR:-${0:A:h}}"

# Machine-local, untracked lines (best-linux-environment's chrome-headless writes
# its exports here).
ZSH_ALIAS_LOCAL="$ZSH_CONFIG_DIR/zsh-alias.local"
[ -f "$ZSH_ALIAS_LOCAL" ] && source "$ZSH_ALIAS_LOCAL"
unset ZSH_ALIAS_LOCAL
